{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "topics-explorer",
  "version": "0.1.0",
  "identifier": "com.severin.topics-explorer",
  "build": {
    "beforeDevCommand": "npm run start",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist/topics-explorer/browser"
  },
  "app": {
    "windows": [
      {
        "title": "TopicsExplorer",
        "width": 1024,
        "height": 768
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.icns", "icons/icon.ico"]
  }
}
